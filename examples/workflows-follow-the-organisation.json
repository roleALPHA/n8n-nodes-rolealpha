      "parameters": {
        "operation": "send",
        "fromEmail": "={{ $('Settings').first().json.mailFrom }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=Workflow change to approve{{ $('Create draft').item.json.codeChanged ? ' (with code)' : '' }}: {{ $('Create draft').item.json.draftName }}",
        "emailFormat": "html",
        "html": "=<p>{{ $('Create draft').item.json.entityName }} was {{ $('Create draft').item.json.change }} in roleALPHA. The model proposes to <b>{{ $('Create draft').item.json.action }}</b> a workflow:</p><blockquote>{{ $('Create draft').item.json.reason }}</blockquote>{{ $('Create draft').item.json.notes.length ? '<p>Before approving: ' + $('Create draft').item.json.notes.join('; ') + '</p>' : '' }}{{ $('Create draft').item.json.reviewHtml }}<p><a href=\"{{ $('Settings').first().json.n8nUrl }}/workflow/{{ $('Create draft').item.json.draftId }}\">Look at the draft</a></p><p><a href=\"{{ $('Settings').first().json.approvalUrl }}?token={{ $json.approveToken }}\">Approve</a> · <a href=\"{{ $('Settings').first().json.approvalUrl }}?token={{ $json.rejectToken }}\">Reject</a></p><p>The links are for you alone and work once, until {{ DateTime.fromISO($json.tokenExpiresAt).toFormat('yyyy-MM-dd HH:mm') }}. You get this because you fill {{ $('Deciding roles').item.json.name }}.</p>",
        "options": {
          "appendAttribution": false
        }
      },
